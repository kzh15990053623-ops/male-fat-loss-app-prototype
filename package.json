{
  "name": "male-fat-loss-app-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build:android": "node scripts/build-android.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "check": "node scripts/run-gates.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "bump:version": "node scripts/bump-version.mjs",
    "check:supabase": "node scripts/check-supabase-readiness.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:supabase": "node scripts/test-supabase-integration.mjs",
    "supabase:test:start": "node scripts/manage-supabase-test-stack.mjs start",
    "supabase:test:stop": "node scripts/manage-supabase-test-stack.mjs stop",
    "test:a11y": "playwright test tests/a11y",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "verify": "npm run check && npm run test:e2e",
    "supabase:login": "npx --yes supabase@2.108.0 login",
    "supabase:link": "npx --yes supabase@2.108.0 link",
    "supabase:db:push": "npx --yes supabase@2.108.0 db push"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.2"
  }
}
