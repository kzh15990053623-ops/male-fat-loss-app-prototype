# Copy this file to .env, then paste the Project URL and Publishable key from Supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for hosted AI budget accounting; also enables cloud account deletion. Server-side only,
# never ship this to the client. Leave empty to keep deletion disabled.
SUPABASE_SERVICE_ROLE_KEY=
# Requires the deployed, JWT-protected delete-own-account Edge Function.
ACCOUNT_DELETION_GATEWAY_ENABLED=false
SUPABASE_PROBE_TIMEOUT_MS=3500
SUPABASE_READINESS_TTL_MS=30000
SUPABASE_REQUEST_TIMEOUT_MS=12000

# Local development fallback. Hosted deployments should keep this false.
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_DATA_PATH=data/local-auth.json

# Real model-backed nutrition analysis. No local-rule fallback is used.
NUTRITION_AI_ENDPOINT=https://api.deepseek.com/chat/completions
NUTRITION_AI_API_KEY=your-server-side-ai-key
NUTRITION_AI_MODEL=deepseek-flash
# deepseek enables photos, bounded output and durable monthly budget enforcement.
# openai-compatible / contract remain available for existing text-only gateways.
NUTRITION_AI_PROTOCOL=deepseek
NUTRITION_AI_TIMEOUT_MS=30000
# Supabase Auth user UUID; REQUIRED on hosted deployments, never accept from request body.
NUTRITION_AI_ALLOWED_USER_ID=
NUTRITION_AI_ALLOWED_USER_IDS=
NUTRITION_AI_USER_MONTHLY_LIMIT=20
NUTRITION_AI_USER_DAILY_LIMIT=5
# Limited server-to-server credential; prefer this over exporting an admin key.
NUTRITION_AI_BUDGET_GATEWAY_TOKEN=
PUBLIC_APP_ORIGIN=http://localhost:5173
NUTRITION_AI_MONTHLY_BUDGET_CNY=100
# Local development only. Hosted deployments always use the Supabase budget RPC.
NUTRITION_AI_BUDGET_PATH=data/nutrition-budget.json
